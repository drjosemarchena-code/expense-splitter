:root {
  font-family: Inter, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  line-height: 1.5;
  font-weight: 400;
  color: #f4f7fb;
  background: #081120;
  font-synthesis: none;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

* {
  box-sizing: border-box;
}

html, body, #root {
  margin: 0;
  min-height: 100%;
  min-width: 100%;
}

body {
  min-height: 100vh;
  background: radial-gradient(circle at top, #16325c 0%, #0a1324 50%, #050b13 100%);
}

button, input, select {
  font: inherit;
}

button {
  border: none;
  border-radius: 10px;
  background: #39b6ff;
  color: #04131d;
  font-weight: 700;
  cursor: pointer;
  transition: transform 0.15s ease, opacity 0.15s ease;
}

button:hover {
  transform: translateY(-1px);
  opacity: 0.96;
}

button.secondary-btn {
  background: rgba(255, 255, 255, 0.08);
  color: #e9f2ff;
}

input, select {
  width: 100%;
  background: rgba(13, 23, 38, 0.7);
  border: 1px solid rgba(158, 180, 204, 0.2);
  border-radius: 10px;
  color: #eef7ff;
  padding: 0.8rem 0.9rem;
}

input::placeholder {
  color: rgba(210, 225, 247, 0.55);
}

.app-shell {
  max-width: 1200px;
  margin: 0 auto;
  padding: 2rem 1.25rem 3rem;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  margin-bottom: 2rem;
}

.eyebrow {
  margin: 0 0 0.4rem;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.72rem;
  color: #8acbff;
}

.topbar h1 {
  margin: 0;
  font-size: clamp(2rem, 4vw, 3rem);
}

.summary-grid,
.content-grid,
.bottom-grid {
  display: grid;
  gap: 1.25rem;
}

.summary-grid {
  grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
  margin-bottom: 1.5rem;
}

.card,
.panel {
  background: rgba(10, 19, 32, 0.82);
  border: 1px solid rgba(153, 181, 219, 0.14);
  border-radius: 18px;
  box-shadow: 0 18px 34px rgba(6, 10, 17, 0.32);
}

.summary-card {
  padding: 1.2rem 1rem;
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.summary-card span {
  color: #a5c3df;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.summary-card strong {
  font-size: 1.7rem;
}

.summary-card.accent {
  background: linear-gradient(135deg, rgba(57, 182, 255, 0.2), rgba(74, 99, 255, 0.16));
}

.content-grid {
  grid-template-columns: minmax(260px, 360px) minmax(0, 1fr);
  margin-bottom: 1.5rem;
}

.bottom-grid {
  grid-template-columns: 1fr 1.1fr;
}

.panel {
  padding: 1.1rem 1rem;
}

.panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.panel-header h2 {
  margin: 0;
  font-size: 1.2rem;
}

.inline-form {
  display: flex;
  gap: 0.75rem;
  margin-bottom: 1rem;
}

.inline-form input {
  flex: 1;
}

.member-list,
.expense-list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.7rem;
}

.member-item,
.expense-item,
.settlement-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 0.8rem;
  padding: 0.8rem 0.9rem;
  background: rgba(18, 28, 43, 0.9);
  border: 1px solid rgba(153, 181, 219, 0.12);
  border-radius: 12px;
}

.member-item strong,
.expense-item strong {
  display: block;
}

.member-item small,
.expense-item small {
  color: #9ab1c9;
  font-size: 0.78rem;
}

.positive {
  color: #69f0a5;
  font-weight: 700;
}

.negative {
  color: #ff9ca5;
  font-weight: 700;
}

.expense-form {
  display: flex;
  flex-direction: column;
  gap: 0.9rem;
}

.expense-form label {
  display: flex;
  flex-direction: column;
  gap: 0.45rem;
  font-weight: 600;
  color: #d3e8ff;
}

.two-col {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.8rem;
}

.checkbox-group {
  background: rgba(12, 23, 35, 0.9);
  border: 1px solid rgba(153, 181, 219, 0.12);
  border-radius: 12px;
  padding: 0.9rem;
}

.checkbox-group p {
  margin: 0 0 0.8rem;
  color: #cfe4ff;
  font-weight: 600;
}

.checkbox-item {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  margin-bottom: 0.45rem;
  color: #ecf7ff;
  font-weight: 500;
}

.checkbox-item input {
  width: auto;
  accent-color: #39b6ff;
}

.primary-btn {
  padding: 0.9rem 1.2rem;
  font-size: 1rem;
}

.settlement-list {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.arrow {
  color: #8acbff;
  font-weight: 700;
}

.empty-state {
  margin: 0;
  color: #9ab1c9;
  text-align: center;
  padding: 1rem 0;
}

@media (max-width: 760px) {
  .content-grid,
  .bottom-grid,
  .two-col {
    grid-template-columns: 1fr;
  }

  .topbar {
    flex-direction: column;
    align-items: flex-start;
  }
}
